# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copie este archivo como `.env` en la raíz del proyecto:
#   Copy-Item .env.example .env
# =============================================================================

# --- 1. Metadatos del Proyecto y Entorno de Ejecución ---
PROJECT_NAME="DatosExpoImportaciones_AlianzaPacifico"
PROJECT_VERSION="2.0.0"
APP_ENV="development"
LOG_LEVEL="INFO"
PYTHONUTF8=1

# --- 2. Rutas de Almacenamiento y Artefactos (DAMA-BOK Data Storage) ---
PROJECT_ROOT="."
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
DOCS_OUTPUT_DIR="docs"
NOTEBOOK_PATH="Analisis_exportaciones.ipynb"
DASHBOARD_HTML_PATH="docs/dashboard_analitico_alianza_pacifico.html"
EDA_PROFILE_HTML_PATH="docs/eda_ydata_profiling_alianza_pacifico.html"

# --- 3. Parámetros de Ingesta y Descarga DANE ANDA ---
DANE_ANDA_BASE_URL="https://microdatos.dane.gov.co/index.php/catalog"
DANE_IMPO_CATALOG_HISTORICAL=473
DANE_IMPO_CATALOG_CURRENT=856
DANE_STAGING_DIR="./tmp/dane_impo_staging"
DANE_HTTP_TIMEOUT_SECONDS=120
DANE_HTTP_MAX_RETRIES=5
DANE_HTTP_CHUNK_SIZE_BYTES=1048576
DANE_MAX_WORKERS=2

# --- 4. Parámetros del Dominio Comercial y Homologación ---
AP_PARTNER_COUNTRIES="CHL,MEX,PER"
STUDY_YEARS="2013,2014,2018,2019,2020,2024,2025"
PRE_AP_YEARS="2013,2014"
POST_AP_YEARS="2018,2019,2020,2024,2025"

# --- 5. Parámetros de Econometría, Distfit y Machine Learning Causal (DML) ---
RANDOM_SEED=42
SIGNIFICANCE_ALPHA=0.05
FE_OLS_COV_TYPE="HC3"
DML_CV_FOLDS=5
RF_N_ESTIMATORS=300
HGBR_MAX_ITER=250
PERMUTATION_REPEATS=30

# --- 6. Configuración de Motores de Visualización y Librerías Científicas ---
MPLBACKEND="Agg"
MPLCONFIGDIR="./tmp/matplotlib_cache"
MATPLOTLIB_DPI=135
PLOTLY_RENDERER="notebook_connected"
PLOTLY_TEMPLATE="plotly_white"
JOBLIB_MULTIPROCESSING=1
NUMEXPR_MAX_THREADS=8
